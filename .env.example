# Copy to .env and adjust. Every value here has a default in app/config.py,
# so you only need the lines you want to change.

# --- run everything locally without Postgres, Redis or a worker ---
CHECKPOINTER_BACKEND=sqlite
CELERY_TASK_ALWAYS_EAGER=true

# --- structured state (PostgreSQL); used when running with Postgres ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/agentdb?connect_timeout=10
CHECKPOINTER_POSTGRES_CONN_STRING=postgresql://postgres:postgres@127.0.0.1:5432/agentdb?connect_timeout=10
CHECKPOINTER_SQLITE_PATH=./data/checkpoints.sqlite

# --- semantic memory (ChromaDB): set CHROMA_URL for a server, otherwise a local folder is used ---
CHROMA_URL=
CHROMA_LOCAL_PATH=./data/chroma_local

# --- Celery broker / result backend ---
REDIS_URL=redis://localhost:6379/0

# --- reasoning backend: local | openai | anthropic ---
LLM_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- embeddings for semantic memory: local | openai ---
EMBEDDING_BACKEND=local

# --- knowledge_base_search tool: URL of a running rag-hybrid-search service ---
RAG_SERVICE_URL=

# --- comma-separated keywords that send a request to human review (local provider) ---
ESCALATION_KEYWORDS=delete,wire transfer,payment,refund,cancel subscription,irreversible
